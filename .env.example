# Google OAuth Client ID
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Tipo: "Web application" (para web) ou "Chrome Extension" (para extensão)
# Sem essa variável definida no momento do build, o login com Google
# fica indisponível (na extensão o manifest.json nem ganha o bloco oauth2).
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Somente para apps/extension: chave pública usada para fixar o ID da
# extensão (necessário para o Client ID tipo "Chrome Extension" bater
# com o ID real da extensão a cada build). Veja README > "Login com Google".
VITE_EXTENSION_KEY=
